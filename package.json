  "scripts": {
    "build": "vite build --mode production --emptyOutDir",
    "dev": "vite --mode development",
    "serve": "npm run build && vite preview"
  },
  "dependencies": {
    "@esri/calcite-components": "5.2.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
